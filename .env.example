APP_NAME="Bible Intelligent Study"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de dados. Em desenvolvimento local é mais simples usar SQLite;
# em produção (ex.: Render) recomenda-se PostgreSQL.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=bibly_study
# DB_USERNAME=postgres
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
CACHE_STORE=database

# --------------------------------------------------------------------------
# Filas (Queue)
# --------------------------------------------------------------------------
# QUEUE_CONNECTION controla a conexão usada por jobs despachados SEM
# ->onConnection(...) explícito. Este projecto não depende de um worker
# (`php artisan queue:work`) em produção: o job de analytics
# (LogBibleQueryJob) é sempre despachado explicitamente na conexão
# 'background', introduzida no Laravel 13, que executa o job num processo
# PHP separado logo após a resposta HTTP ser enviada — sem precisar de um
# worker persistente. Isto é o que permite manter o Render como um único
# serviço web (sem dyno/worker adicional).
#
# 'database' é um valor seguro para o QUEUE_CONNECTION por defeito: em dev,
# `composer run dev` já arranca `queue:listen` para processar quaisquer
# outros jobs que não especifiquem conexão. Em produção no Render, se
# adicionares jobs novos sem worker disponível, despacha-os sempre com
# ->onConnection('background') ou ->onConnection('deferred').
QUEUE_CONNECTION=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Inteligência Artificial
# --------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
